# syntax=docker/dockerfile:1
# Generated by make-standalone.sh from Dockerfile, clank and lib/: edit those, not this.
# clank-box — one container that runs Clank Together sessions.
# Built for linux/amd64 on every host (docker build --platform linux/amd64): the official td and
# the 64-bit MSVC cl.exe (under wine64) run natively on x86_64, under Docker Desktop's Rosetta
# on Apple Silicon.
# Nothing personal here: the td token, the agent and its login arrive at run time and live in
# the home volume.
#
# Build (instant once built, unless something changed) and run, from this folder:
#   docker build --platform linux/amd64 -t clank-box . && docker run -it --rm --platform linux/amd64 --name clank-box -e AI -e WEEK_USD -e TD_TOKEN -v clank-home:/home/clank clank-box
# It asks claude or codex, then the weekly budget (Enter keeps the last answers).
# Codex is UNTESTED: it installs Codex, logs it in and connects it, then stops (no capped sessions yet).
# AI, WEEK_USD and TD_TOKEN set right before docker run skip their question
# (… && AI=claude WEEK_USD=30 docker run …).
# A second box at the same time (same login, same weekly budget, its own workspace):
#   docker build --platform linux/amd64 -t clank-box . && docker run -it --rm --platform linux/amd64 --name clank-box-2 -e BOX=2 -e AI -e WEEK_USD -v clank-home:/home/clank clank-box
# A brand-new box, to replay a first start (its own login, workspace and budget):
#   docker build --platform linux/amd64 -t clank-box . && docker run -it --rm --platform linux/amd64 --name clank-test -v clank-test-home:/home/clank clank-box
# From Dockerfile.clank alone: docker build --platform linux/amd64 -t clank-box - < Dockerfile.clank
# Node 24, not 26: under Rosetta, Node 26.13 reads 0.03 as 0 and 15.3 as 15 (the cap would never stop).
FROM node:24-bookworm-slim

# wine64: td compiles with a 64-bit cl.exe (Hostx64), which a 32-bit wine cannot load.
RUN apt-get update \
	&& apt-get install -y --no-install-recommends git curl ca-certificates wine64 procps tini \
	&& rm -rf /var/lib/apt/lists/* \
	# td runs `wine`; Debian's wine64 package only ships the 64-bit loader, which must be
	# called by its own path (through a symlink it cannot find the rest of wine)
	&& printf '#!/bin/sh\nexec /usr/lib/wine/wine64 "$@"\n' > /usr/local/bin/wine \
	&& chmod +x /usr/local/bin/wine

# The runtime user; its home is the named volume (agent, login, td, workspace, toolchain).
RUN useradd --create-home --shell /bin/bash clank \
	&& install -d -o clank -g clank /opt/wineprefix64

USER clank
# The win64 prefix, made once here rather than at every first compile.
ENV WINEPREFIX=/opt/wineprefix64 WINEARCH=win64 WINEDEBUG=-all
RUN wine wineboot --init \
	&& /usr/lib/wine/wineserver64 --wait \
	&& test -f /opt/wineprefix64/system.reg

COPY --chown=clank:clank <<'CLANK_BOX_FILE_END' /opt/clank-box/lib/emulation.mjs
// Which emulator runs x86_64 programs here: prints rosetta, qemu or unknown.
// Docker Desktop on Apple Silicon picks Rosetta when its setting is on, else falls back to qemu
// (much slower); on an x86_64 host nothing emulates and the probe says unknown.
// Executes a tiny x86_64 ELF whose interpreter does not exist: the emulator that takes it
// names itself in its error.

import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { spawnSync } from 'node:child_process'

const INTERP = '/nonexistent-td-probe\0'
// header, then PT_INTERP and PT_LOAD (a whole program, so the emulator gets as far as the interpreter)
const AT = 64 + 2 * 56
const elf = Buffer.alloc(AT + INTERP.length)
elf.write('\x7fELF', 0, 'latin1')
elf.writeUInt8(2, 4) // 64-bit
elf.writeUInt8(1, 5) // little endian
elf.writeUInt8(1, 6) // ELF version
elf.writeUInt16LE(2, 16) // ET_EXEC
elf.writeUInt16LE(0x3e, 18) // x86-64
elf.writeUInt32LE(1, 20)
elf.writeBigUInt64LE(0x400000n + BigInt(AT), 24) // entry
elf.writeBigUInt64LE(64n, 32) // program headers right after this header
elf.writeUInt16LE(64, 52)
elf.writeUInt16LE(56, 54)
elf.writeUInt16LE(2, 56)
elf.writeUInt16LE(64, 58)
const phdr = (at, type, flags, offset, size, align) => {
  elf.writeUInt32LE(type, at)
  elf.writeUInt32LE(flags, at + 4)
  elf.writeBigUInt64LE(BigInt(offset), at + 8)
  elf.writeBigUInt64LE(0x400000n + BigInt(offset), at + 16)
  elf.writeBigUInt64LE(0x400000n + BigInt(offset), at + 24)
  elf.writeBigUInt64LE(BigInt(size), at + 32)
  elf.writeBigUInt64LE(BigInt(size), at + 40)
  elf.writeBigUInt64LE(BigInt(align), at + 48)
}
phdr(64, 3, 4, AT, INTERP.length, 1) // PT_INTERP
phdr(120, 1, 5, 0, elf.length, 0x1000) // PT_LOAD
elf.write(INTERP, AT, 'latin1')

const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'td-emu-'))
const probe = path.join(dir, 'probe')
fs.writeFileSync(probe, elf, { mode: 0o755 })
const r = spawnSync(probe, { encoding: 'utf8' })
fs.rmSync(dir, { recursive: true })
const said = `${r.stdout ?? ''}${r.stderr ?? ''}${r.error?.message ?? ''}`.toLowerCase()
console.log(said.includes('rosetta') ? 'rosetta' : said.includes('qemu') ? 'qemu' : 'unknown')
CLANK_BOX_FILE_END

COPY --chown=clank:clank <<'CLANK_BOX_FILE_END' /opt/clank-box/lib/quota.mjs
// Claude subscription quota from token usage: tokens are priced per model at API prices, then
// divided by the dollars one percentage point of the plan's weekly (or 5 h) window is worth.
//
//   const rate = planRate()          // the detected plan: { plan, label, h5, d7, estimated, from }
//   const meter = createMeter(rate)
//   meter.add(streamJsonLine)        // any parsed stream-json line
//   meter.estimate()                 // { usd, h5, d7, unknownModels } — h5 / d7 as fractions (0.01 = 1 %)

import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { spawnSync } from 'node:child_process'

// $ per million tokens: input, cache write 5 min, cache write 1 h, cache read, output.
// Matched by prefix in this order: claude-fable-5-1 must stay before claude-fable-5.
export const PRICES = {
  'claude-fable-5-1': [10, 12.5, 20, 0.25, 50],
  'claude-fable-5': [10, 12.5, 20, 1, 50],
  'claude-opus-5-5': [4, 5, 8, 0.2, 20],
  'claude-sonnet-5': [2, 2.5, 4, 0.2, 10],
  'claude-haiku-4-5': [1, 1.25, 2, 0.1, 5],
}

// Opus 5.5 dollars per percentage point of each window, measured on real accounts.
// Pro was never measured: a fifth of Max 5x, the ratio the plan names.
export const PLANS = {
  max20x: { label: 'Max 20x', h5: 8.05, d7: 30.5 },
  max5x: { label: 'Max 5x', h5: 2.02, d7: 15.3 },
  pro: { label: 'Pro', h5: 2.02 / 5, d7: 15.3 / 5, estimated: true },
}
// the smallest measured plan overstates what a bigger one burns: unknown plans err on the safe side
const FALLBACK = 'max5x'

// Quota points per dollar, relative to Opus 5.5: a Fable dollar burns 2.7 times more of the
// windows than an Opus dollar. Matched by prefix.
export const QUOTA_WEIGHT = { 'claude-fable-5': 2.7 }

const weightOf = (model) => {
  for (const id in QUOTA_WEIGHT) if (model.startsWith(id)) return QUOTA_WEIGHT[id]
  return 1
}

/** The plan named by the login's rate-limit tier or subscription type, or null. */
export function planOfLogin({ rateLimitTier, subscriptionType } = {}) {
  if (/max_20x/.test(rateLimitTier || '')) return 'max20x'
  if (/max_5x/.test(rateLimitTier || '')) return 'max5x'
  if (subscriptionType === 'pro') return 'pro'
  return null
}

/**
 * The plan to count with: PLAN when set, else the login's (the saved credentials name the tier,
 * `claude auth status` only pro / max), else Max 5x.
 */
export function detectPlan(env = process.env, home = os.homedir()) {
  if (env.PLAN) {
    if (!PLANS[env.PLAN]) throw new Error(`PLAN=${env.PLAN}: expected one of ${Object.keys(PLANS).join(', ')}`)
    return { plan: env.PLAN, from: 'PLAN' }
  }
  try {
    const o = JSON.parse(fs.readFileSync(path.join(home, '.claude/.credentials.json'), 'utf8')).claudeAiOauth
    const p = planOfLogin(o)
    if (p) return { plan: p, from: 'login' }
  } catch {
    // no saved login (CLAUDE_CODE_OAUTH_TOKEN, or not logged in yet)
  }
  const r = spawnSync('claude', ['auth', 'status', '--json'], { encoding: 'utf8', env })
  try {
    const p = planOfLogin(JSON.parse(r.stdout))
    if (p) return { plan: p, from: 'claude auth status' }
  } catch {
    // no claude, or no JSON
  }
  return { plan: FALLBACK, from: 'default (plan unknown: set PLAN)' }
}

/** Dollars per point of the detected plan. */
export function planRate(env = process.env, home = os.homedir()) {
  const { plan, from } = detectPlan(env, home)
  return { plan, from, ...PLANS[plan] }
}

// Unknown models are priced as Opus 5.5.
const FALLBACK_MODEL = 'claude-opus-5-5'

const priceOf = (model) => {
  for (const id in PRICES) if (model.startsWith(id)) return PRICES[id]
  return null
}

/** Dollars for one `usage` object (API field names) on `model`. */
export function usdOf(usage, model) {
  const p = priceOf(model) || PRICES[FALLBACK_MODEL]
  const cc = usage.cache_creation
  // Older lines carry only the total; bill it as a 5 min write.
  const w1h = cc ? cc.ephemeral_1h_input_tokens || 0 : 0
  const w5m = cc ? cc.ephemeral_5m_input_tokens || 0 : usage.cache_creation_input_tokens || 0
  return (
    ((usage.input_tokens || 0) * p[0] +
      w5m * p[1] +
      w1h * p[2] +
      (usage.cache_read_input_tokens || 0) * p[3] +
      (usage.output_tokens || 0) * p[4]) /
    1e6
  )
}

const FIELDS = ['input_tokens', 'cache_read_input_tokens', 'output_tokens']

/**
 * Accumulates assistant lines, deduplicated by message id: a message is written once
 * per content block.
 */
export function createMeter(rate) {
  const seen = {}
  return {
    add(line) {
      if (line.type !== 'assistant') return
      const msg = line.message
      const usage = msg && msg.usage
      if (!usage || msg.model === '<synthetic>') return
      const id = msg.id || line.uuid
      const cc = usage.cache_creation
      const u = {
        input_tokens: usage.input_tokens || 0,
        cache_read_input_tokens: usage.cache_read_input_tokens || 0,
        output_tokens: usage.output_tokens || 0,
        cache_creation: cc
          ? {
              ephemeral_5m_input_tokens: cc.ephemeral_5m_input_tokens || 0,
              ephemeral_1h_input_tokens: cc.ephemeral_1h_input_tokens || 0,
            }
          : { ephemeral_5m_input_tokens: usage.cache_creation_input_tokens || 0, ephemeral_1h_input_tokens: 0 },
      }
      const prev = seen[id]
      if (!prev) {
        seen[id] = { model: msg.model, usage: u }
        return
      }
      // Later lines of the same message can carry a larger output count.
      const p = prev.usage
      for (const f of FIELDS) if (u[f] > p[f]) p[f] = u[f]
      const pc = p.cache_creation
      const nc = u.cache_creation
      if (nc.ephemeral_5m_input_tokens > pc.ephemeral_5m_input_tokens) pc.ephemeral_5m_input_tokens = nc.ephemeral_5m_input_tokens
      if (nc.ephemeral_1h_input_tokens > pc.ephemeral_1h_input_tokens) pc.ephemeral_1h_input_tokens = nc.ephemeral_1h_input_tokens
    },
    estimate() {
      let usd = 0
      let weighted = 0
      const unknown = {}
      for (const id in seen) {
        const m = seen[id]
        if (!priceOf(m.model)) unknown[m.model] = true
        const u = usdOf(m.usage, m.model)
        usd += u
        weighted += u * weightOf(m.model)
      }
      return { usd, h5: weighted / rate.h5 / 100, d7: weighted / rate.d7 / 100, unknownModels: Object.keys(unknown) }
    },
  }
}
CLANK_BOX_FILE_END

COPY --chown=clank:clank <<'CLANK_BOX_FILE_END' /opt/clank-box/lib/same-build.mjs
// Does this machine's compiler build what the server builds? For each unit, compiles it here
// (td check on the clean HEAD) and compares every function's exact / not-exact status with
// the server's record of main. A different compiler, flag or runtime shows up as exact
// functions that stop matching.
//
//   clank check [unit.cpp ...]     (default: two Archive units)
// Exit 1 on any disagreement.

import fs from 'node:fs'
import path from 'node:path'
import { execFileSync } from 'node:child_process'
import { WS } from './session-status.mjs'

const config = JSON.parse(fs.readFileSync(path.join(WS, '.td/config.json'), 'utf8'))

let asked = 0
const task = async (n) => {
  if (++asked % 10 === 0) progress(`server lookups: ${asked}`)
  const r = await fetch(`${config.server}/api/tasks/${n}`, { headers: { authorization: `Bearer ${config.token}` } })
  return r.ok ? r.json() : null
}

// one line on stderr that rewrites itself in a terminal, plain lines otherwise
const progress = (msg) => process.stderr.write(process.stderr.isTTY ? `\r\x1b[2K… ${msg}` : `… ${msg}\n`)
const done = () => process.stderr.isTTY && process.stderr.write('\r\x1b[2K')

const num = (id) => +String(id).slice(3)
const unitOf = (j, fnId) => {
  const status = {}
  for (const n of j.unitNeighbours) if (n.status) status[n.id] = n.status
  if (j.task.state === 'done') status[fnId] = j.task.bestScore === 1 ? 'exact' : 'mismatch'
  return status
}

// Tasks are mostly numbered in function id order, with later-found functions (far higher
// ids) slotted in: binary search ignoring those, then scan the neighbourhood.
async function serverUnit(fnId) {
  const want = num(fnId)
  let lo = 1
  let hi = 1e5
  while (hi - lo > 40) {
    let mid = (lo + hi) >> 1
    let j = await task(mid)
    for (let k = 0; k < 50 && j?.symbol && num(j.symbol.id) - want > 20000 && mid < hi; k++) j = await task(++mid)
    if (!j?.symbol) hi = mid - 1
    else if (j.symbol.id === fnId) return unitOf(j, fnId)
    else if (num(j.symbol.id) < want) lo = mid + 1
    else hi = mid - 1
  }
  // the neighbourhood, 20 requests at a time
  for (let n = Math.max(1, lo - 40); n <= hi + 40; n += 20) {
    const batch = await Promise.all(Array.from({ length: 20 }, (_, k) => task(n + k)))
    const j = batch.find((t) => t?.symbol?.id === fnId)
    if (j) return unitOf(j, fnId)
  }
  return null
}

const units = process.argv.slice(2)
if (!units.length) units.push('Source/Archive/PakCipher.cpp', 'Source/Archive/GPak.cpp')
let bad = 0
for (const [i, unit] of units.entries()) {
  progress(`[${i + 1}/${units.length}] compiling ${unit}`)
  const out = execFileSync('td', ['check', unit, '--json'], { cwd: WS, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] })
  const local = JSON.parse(out).units.find((u) => u.file === unit)
  if (!local?.compiled) {
    done()
    console.log(`✗ ${unit}: does not compile here`)
    bad++
    continue
  }
  progress(`[${i + 1}/${units.length}] asking the server about ${unit}`)
  // not every function has a task: try them from the unit's typical id outwards (an id far
  // from its neighbours' was found later and sits out of order), at most 4
  const ids = local.functions.map((f) => num(f.id)).sort((a, b) => a - b)
  const median = ids[ids.length >> 1]
  const order = [...local.functions].sort((a, b) => Math.abs(num(a.id) - median) - Math.abs(num(b.id) - median))
  let server = null
  for (const f of order.slice(0, 4)) if ((server = await serverUnit(f.id))) break
  let same = 0
  for (const f of local.functions) {
    const s = server?.[f.id]
    if (!s) continue
    const here = f.status === 'exact' ? 'exact' : 'mismatch'
    if (here === (s === 'exact' ? 'exact' : 'mismatch')) same++
    else {
      console.log(`✗ ${unit} ${f.id} ${f.name}: server ${s}, here ${f.status} ${(f.score * 100).toFixed(1)} %`)
      bad++
    }
  }
  done()
  const exact = local.functions.filter((f) => f.status === 'exact').length
  console.log(`${same ? '✓' : '?'} ${unit}: ${same} functions agree with the server (${exact} exact here)`)
}
process.exit(bad ? 1 : 0)
CLANK_BOX_FILE_END

COPY --chown=clank:clank <<'CLANK_BOX_FILE_END' /opt/clank-box/lib/session-status.mjs
// Live, readable status of a capped Clank Together session: one line per action (td tool,
// shell command, message from the agent, error), each with the dollars spent so far.
//
//   node session-status.mjs [--tui] [log.jsonl]   follow a session's log (default: the running one,
//                                                 else the newest); --tui: full-screen view
// week-cap.mjs prints the same lines while it runs the session.

import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import os from 'node:os'
import { createMeter, planRate, QUOTA_WEIGHT } from './quota.mjs'
import { ledgerOf, readLedger } from './week-ledger.mjs'

// a closed pipe (`| head`) ends the output quietly
process.stdout.on('error', () => process.exit(0))

// the workspace install.sh sets up (TD_DIR, default ~/clank/rodecomp)
export const WS = process.env.TD_DIR || path.join(os.homedir(), 'clank/rodecomp')
export const LOGS = path.join(WS, '.td/logs')
const TTY = process.stdout.isTTY
const dim = (s) => (TTY ? `\x1b[2m${s}\x1b[0m` : s)
const red = (s) => (TTY ? `\x1b[31m${s}\x1b[0m` : s)
const cut = (s, n) => (s.length > n ? s.slice(0, n - 1) + '…' : s)

/** s cut to `cols` visible characters (colour codes do not count), so no line ever wraps. */
function fit(s, cols) {
  let out = ''
  let seen = 0
  for (let i = 0; i < s.length; i++) {
    if (s[i] === '\x1b') {
      const end = s.indexOf('m', i)
      out += s.slice(i, end + 1)
      i = end
      continue
    }
    if (seen === cols - 1 && s.slice(i).replace(/\x1b\[[0-9;]*m/g, '').length > 1) return out + '…\x1b[0m'
    out += s[i]
    seen++
  }
  return out
}

// Visible output characters per output token (text and tool inputs), fitted on a 394-message
// session: 199 k characters for 111 k output tokens once thinking is set aside.
const CHARS_PER_TOKEN = 2

/**
 * The session's spend, every run of the log included. The stream's assistant lines carry the
 * output count of the message's start, so while a run is in progress its output is estimated
 * from the thinking_tokens lines and the visible characters; a run's result line replaces the
 * estimate with its exact cost.
 */
export function createSessionMeter(rate) {
  let meter = createMeter(rate)
  let thinking = 0
  let chars = Object.create(null)
  const done = { usd: 0, weighted: 0 }
  return {
    add(msg) {
      if (msg.type === 'system' && msg.subtype === 'thinking_tokens') {
        thinking += msg.estimated_tokens_delta || 0
        return
      }
      if (msg.type === 'result') {
        for (const m in msg.modelUsage ?? {}) {
          const usd = msg.modelUsage[m].costUSD || 0
          let weight = 1
          for (const id in QUOTA_WEIGHT) if (m.startsWith(id)) weight = QUOTA_WEIGHT[id]
          done.usd += usd
          done.weighted += usd * weight
        }
        meter = createMeter(rate)
        thinking = 0
        chars = Object.create(null)
        return
      }
      const m = msg.type === 'assistant' && msg.message
      if (!m?.usage) return meter.add(msg)
      const id = m.id || msg.uuid
      const c = chars[id] || (chars[id] = { visible: 0, thinking: 0 })
      // thinking reported since the last message belongs to this one
      c.thinking += thinking
      thinking = 0
      for (const b of m.content ?? []) {
        if (b.type === 'text') c.visible += b.text.length
        else if (b.type === 'tool_use') c.visible += b.name.length + JSON.stringify(b.input ?? {}).length
      }
      const output = Math.round(c.thinking + c.visible / CHARS_PER_TOKEN)
      meter.add(output > (m.usage.output_tokens || 0) ? { ...msg, message: { ...m, usage: { ...m.usage, output_tokens: output } } } : msg)
    },
    estimate() {
      const e = meter.estimate()
      return {
        usd: e.usd + done.usd,
        h5: e.h5 + done.weighted / rate.h5 / 100,
        d7: e.d7 + done.weighted / rate.d7 / 100,
        unknownModels: e.unknownModels,
      }
    },
  }
}

/** HH:MM:SS of a message: its own timestamp, else the last one seen. */
function clockOf() {
  let last = null
  return (msg, n = 8) => {
    if (msg.timestamp) last = new Date(msg.timestamp)
    return (last ?? new Date()).toTimeString().slice(0, n)
  }
}

/** One readable line for a parsed stream-json message, or null when there is nothing to show. */
export function describe(msg) {
  if (msg.type === 'assistant') {
    const parts = []
    for (const c of msg.message?.content ?? []) {
      if (c.type === 'tool_use') {
        const name = c.name.replace(/^mcp__clank-together__/, '')
        const arg = c.name === 'Bash' ? c.input.description || c.input.command : JSON.stringify(c.input)
        parts.push(`▸ ${name} ${cut(String(arg ?? ''), 90)}`)
      } else if (c.type === 'text' && c.text.trim()) parts.push(`“${cut(c.text.trim().split('\n')[0], 110)}”`)
    }
    return parts.length ? parts.join('\n') : null
  }
  if (msg.type === 'user') {
    for (const c of msg.message?.content ?? []) {
      if (c.type === 'tool_result' && c.is_error) {
        const text = typeof c.content === 'string' ? c.content : (c.content ?? []).map((x) => x.text ?? '').join(' ')
        return red(`✗ ${cut(text.replace(/\s+/g, ' '), 110)}`)
      }
    }
    return null
  }
  if (msg.type === 'result') return `■ ${msg.subtype}, ${msg.num_turns} turns`
  return null
}

/** A status printer: feed it parsed messages, it prints lines prefixed with time and $ spent. */
export function createStatus(rate = planRate(), write = (s) => process.stdout.write(s)) {
  const meter = createSessionMeter(rate)
  const at = clockOf()
  return (msg) => {
    meter.add(msg)
    const time = at(msg, 5)
    const line = describe(msg)
    if (!line) return
    const head = dim(`${time} ${meter.estimate().usd.toFixed(2)} $`)
    for (const l of line.split('\n')) write(`${head} ${l}\n`)
  }
}

/** The cap (dollars) of the week-cap.mjs process writing `file`, or of the running one when
 *  `file` is null, with its log; null when none runs. */
function runningCap(file) {
  for (const pid of fs.readdirSync('/proc').filter((d) => /^\d+$/.test(d))) {
    let argv
    try {
      argv = fs.readFileSync(`/proc/${pid}/cmdline`, 'utf8').split('\0')
    } catch {
      continue
    }
    const at = argv.findIndex((a) => a.endsWith('week-cap.mjs'))
    if (at === -1 || !argv[at + 2] || (file && path.resolve(file) !== path.resolve(argv[at + 2]))) continue
    return { cap: Number(argv[at + 1]), file: argv[at + 2] }
  }
  return null
}

// Calls onMsg for each message of the log, existing ones first, then as they arrive, until
// a run's result line with no week-cap left to start the next run.
async function follow(file, onMsg) {
  let pos = 0
  let rest = ''
  let ended = false
  for (;;) {
    const size = fs.statSync(file).size
    if (size === pos && ended && !runningCap(file)) return
    if (size > pos) {
      const fd = fs.openSync(file, 'r')
      const buf = Buffer.alloc(size - pos)
      fs.readSync(fd, buf, 0, buf.length, pos)
      fs.closeSync(fd)
      pos = size
      const lines = (rest + buf.toString()).split('\n')
      rest = lines.pop()
      for (const l of lines) {
        let msg
        try {
          msg = JSON.parse(l)
        } catch {
          continue
        }
        if (onMsg(msg) === false) return
        ended = msg.type === 'result'
      }
    }
    await new Promise((r) => setTimeout(r, 500))
  }
}

const clock = (ms) => {
  const m = Math.floor(ms / 6e4)
  return m >= 60 ? `${Math.floor(m / 60)} h ${String(m % 60).padStart(2, '0')}` : `${m} min ${String(Math.floor(ms / 1e3) % 60).padStart(2, '0')} s`
}

// Full-screen view, redrawn every second: budget, the action in progress, td tool counts,
// and the latest lines.
async function tui(file, cap) {
  const meter = createSessionMeter(planRate())
  const at = clockOf()
  const started = fs.statSync(file).birthtimeMs || Date.now()
  const pending = {}
  const counts = {}
  const recent = []
  let accountWeek = null
  let ended = null
  let errors = 0
  let lastAt = Date.now()
  const scores = {}
  let server = null
  // the account's region and 24 h record, from the server every 30 s
  const config = JSON.parse(fs.readFileSync(path.join(WS, '.td/config.json'), 'utf8'))
  const poll = async () => {
    try {
      const get = (p) => fetch(config.server + p, { headers: { authorization: `Bearer ${config.token}` }, signal: AbortSignal.timeout(1e4) }).then((r) => r.json())
      const [me, quality] = await Promise.all([get('/api/me'), get('/api/me/quality')])
      server = { me, quality, at: Date.now() }
    } catch {
      // keep the last answer
    }
  }
  poll()
  const poller = setInterval(poll, 3e4)
  const add = (msg) => {
    meter.add(msg)
    lastAt = Date.now()
    if (msg.type === 'rate_limit_event') accountWeek = msg.rate_limit_info?.unifiedWindows?.seven_day?.utilization ?? accountWeek
    // a result ends one run; week-cap may start the next
    ended = msg.type === 'result' ? msg.subtype : null
    const time = at(msg)
    for (const c of msg.message?.content ?? []) {
      if (c.type === 'tool_use') {
        const name = c.name.replace(/^mcp__clank-together__/, '')
        pending[c.id] = { line: describe({ type: 'assistant', message: { content: [c] } }), at: Date.now() }
        // td through MCP (td_claim_region) or the shell (td region claim …)
        const cli = c.name === 'Bash' && /(?:^|[;&|(]\s*)td\s+([a-z-]+(?:\s+(?:claim|release|new|download|install|build|sync))?)/.exec(c.input.command || '')
        const key = name.startsWith('td_') ? name.slice(3) : cli ? cli[1].replace(/\s+/, ' ') : null
        if (key) counts[key] = (counts[key] || 0) + 1
      }
      if (c.type === 'tool_result') {
        delete pending[c.tool_use_id]
        if (c.is_error) errors++
        // td check lines: "  fn_18130 0x00aebc00 CGPak::Reset   exact   100.0%  size 55/55"
        const text = typeof c.content === 'string' ? c.content : (c.content ?? []).map((x) => x.text ?? '').join('\n')
        for (const m of text.matchAll(/^\s*(fn_\d+) 0x[0-9a-f]+ .*?\s(exact|mismatch|[a-z_]+)\s+([\d.]+)%\s+size/gm)) {
          scores[m[1]] = { status: m[2], score: +m[3] }
        }
        // td check --json / td_check: {"id":"fn_…", …, "status":"exact","score":1, …}
        for (const m of text.matchAll(/"id":\s*"(fn_\d+)"[^{}]*?"status":\s*"(\w+)",\s*"score":\s*([\d.]+)/g)) {
          scores[m[1]] = { status: m[2], score: +m[3] * 100 }
        }
      }
    }
    const line = describe(msg)
    if (line) for (const l of line.split('\n')) recent.push(`${dim(time)} ${l}`)
    if (recent.length > 200) recent.splice(0, recent.length - 200)
  }
  const checkLine = () => {
    const v = Object.values(scores)
    if (!v.length) return dim('no td check yet')
    const exact = v.filter((x) => x.status === 'exact').length
    return `${v.length} functions checked · ${exact} exact · average ${(v.reduce((a, x) => a + x.score, 0) / v.length).toFixed(1)} %`
  }
  const workLines = () => {
    if (!server) return [`Work  ${dim('asking the server…')}`]
    const { me, quality: q } = server
    const regions = (me.regions ?? []).map((r) => `${r.key} (lease ${clock(Math.max(0, r.expires - Date.now()))})`).join(', ') || 'none'
    const states = {}
    for (const t of me.regionTasks ?? []) states[t.state] = (states[t.state] || 0) + 1
    const tally = Object.keys(states).sort().map((k) => `${states[k]} ${k}`).join(' · ')
    return [
      `Work  region ${regions} — ${(me.leases ?? []).length} to port (held by this account)${tally ? ' · ' + tally : ''}`,
      `24 h  ${q.submitted} submitted · ${q.merged} merged · ${q.identical} identical · ${q.trust?.reviewer?.reviews ?? 0} reviews · quality ${q.level} ${dim(`(server ${clock(Date.now() - server.at)} ago)`)}`,
    ]
  }
  const draw = () => {
    const rows = process.stdout.rows || 30
    const cols = process.stdout.columns || 100
    const e = meter.estimate()
    // the bar is Clank Together's week, every session together; this session's share next to it
    const week = readLedger(ledgerOf(file))
    const spent = week.usd
    const width = Math.max(10, Math.min(40, cols - 50))
    const fill = cap ? Math.min(width, Math.round((spent / cap) * width)) : 0
    const bar = `${cap ? `[${'█'.repeat(fill)}${'░'.repeat(width - fill)}] ${spent.toFixed(2)} / ${cap} $` : `${spent.toFixed(2)} $`} this week (≈ ${(week.d7 * 100).toFixed(2)} %) · this session ${e.usd.toFixed(2)} $`
    const now = Object.values(pending).sort((a, b) => b.at - a.at)[0]
    const doing = ended
      ? `■ session ended: ${ended}`
      : now
        ? `${now.line}  ${dim(`(${clock(Date.now() - now.at)})`)}`
        : `… thinking  ${dim(`(${clock(Date.now() - lastAt)})`)}`
    const tally = Object.keys(counts).sort().map((k) => `${k} ${counts[k]}`).join(' · ') || '—'
    const head = [
      `Clank Together session · ${path.basename(file)} · running ${clock(Date.now() - started)}`,
      `Budget ${bar} · account week ${accountWeek === null ? '?' : (accountWeek * 100).toFixed(0) + ' %'}`,
      '',
      `Now   ${doing}`,
      `td    ${tally}${errors ? ' · ' + red(`${errors} errors`) : ''}`,
      `Check ${checkLine()}`,
      ...workLines(),
      dim('─'.repeat(Math.min(cols, 100))),
    ]
    const tail = recent.slice(-(rows - head.length))
    // every line cut to the width and cleared to its end: the frame is exactly one screen
    process.stdout.write('\x1b[H' + [...head, ...tail].map((l) => fit(l, cols - 1) + '\x1b[K').join('\n') + '\x1b[J')
  }
  // the terminal's alternate screen, like top or less: the shell's scrollback stays untouched
  process.stdout.write('\x1b[?1049h\x1b[?25l')
  const restore = () => process.stdout.write('\x1b[?25h\x1b[?1049l')
  process.stdout.on('resize', () => draw())
  for (const sig of ['SIGINT', 'SIGTERM', 'SIGHUP']) {
    process.on(sig, () => {
      restore()
      process.exit(0)
    })
  }
  const timer = setInterval(draw, 1000)
  await follow(file, add)
  draw()
  clearInterval(timer)
  clearInterval(poller)
  restore()
}

if (process.argv[1] === fileURLToPath(import.meta.url)) {
  const args = process.argv.slice(2)
  const wantTui = args.includes('--tui')
  let file = args.find((a) => !a.startsWith('--'))
  // default: the session running now (its week-cap names the cap and the log), else the log
  // written last
  const running = runningCap(file)
  const cap = running?.cap ?? null
  file = running?.file ?? file
  if (!file) {
    const runs = fs.readdirSync(LOGS).filter((f) => f.endsWith('.jsonl'))
    if (!runs.length) throw new Error(`no session log in ${LOGS}`)
    const mtime = (f) => fs.statSync(path.join(LOGS, f)).mtimeMs
    file = path.join(LOGS, runs.reduce((a, b) => (mtime(b) > mtime(a) ? b : a)))
  }
  if (wantTui && process.stdout.isTTY) await tui(file, cap)
  else {
    console.log(dim(`following ${file} (Ctrl+C to stop watching; the session keeps running)`))
    const status = createStatus()
    await follow(file, status)
  }
}
CLANK_BOX_FILE_END

COPY --chown=clank:clank <<'CLANK_BOX_FILE_END' /opt/clank-box/lib/week-cap.mjs
// Run `claude -p … --output-format stream-json` and stop it once Clank Together has spent its
// weekly budget in API-price dollars, this session and the earlier ones of the same week
// together (week-ledger.mjs). The share of the week it stands for is only shown, converted with
// the detected plan (quota.mjs); the account's real weekly meter (rate_limit_event lines)
// enforces the ceiling, WEEK_UNTIL % (default 80). When the agent ends its turn under the
// budget, the same command runs again, appending to the same log.
//
//   [WEEK_UNTIL=n] [PLAN=…] node week-cap.mjs <dollars> <log.jsonl> -- claude -p … (without --max-budget-usd)
//   node week-cap.mjs clear <logs dir>      the week's budget starts again from zero

import fs from 'node:fs'
import path from 'node:path'
import readline from 'node:readline'
import { spawn } from 'node:child_process'
import { fileURLToPath } from 'node:url'
import { planRate } from './quota.mjs'
import { LOGS, createSessionMeter, createStatus } from './session-status.mjs'
import { ledgerOf, readLedger, resetOf, writeLedger } from './week-ledger.mjs'

// Never let the account's week go past this, whatever the session has spent.
const CEILING = Number(process.env.WEEK_UNTIL || 80) / 100
// --max-budget-usd sits above the meter's own stop, in case the meter misses lines.
const BACKSTOP = 1.2
// A run that ends in fewer turns did no work (budget judged too small, nothing to claim):
// running it again would only repeat that.
const MIN_TURNS = 10
// Less than this left of the week's budget: not worth a new run (it would stop at once).
const MIN_RUN = 1

/** seven_day utilization of one parsed stream-json line, or null. */
export function weekOf(msg) {
  if (msg.type !== 'rate_limit_event') return null
  const u = msg.rate_limit_info?.unifiedWindows?.seven_day?.utilization
  return typeof u === 'number' ? u : null
}

/** Tokens of a result line, all models and sub-agents included. */
export function tokensOf(result) {
  let n = 0
  for (const m in result?.modelUsage ?? {}) {
    const u = result.modelUsage[m]
    n += (u.inputTokens || 0) + (u.outputTokens || 0) + (u.cacheReadInputTokens || 0) + (u.cacheCreationInputTokens || 0)
  }
  return n
}

const pct = (f) => (f * 100).toFixed(2)
const usd = (n) => `${n.toFixed(2)} $`

const until = (resetsAt) => (resetsAt ? `until ${new Date(resetsAt * 1000).toLocaleString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}` : 'until the account week resets')

async function main() {
  const [budgetArg, log, sep, ...cmd] = process.argv.slice(2)
  if (budgetArg === 'clear') {
    const file = ledgerOf(path.join(log || LOGS, 'x'))
    const l = readLedger(file)
    writeLedger(file, { usd: 0, d7: 0, resetsAt: l.resetsAt })
    process.stderr.write(`week-cap: Clank Together's week cleared (was ${usd(l.usd)})\n`)
    return
  }
  const budget = Number(budgetArg)
  if (!(budget > 0) || !log || sep !== '--' || !cmd.length) {
    throw new Error('usage: node week-cap.mjs <dollars> <log.jsonl> -- <claude command>')
  }
  if (!(CEILING > 0 && CEILING <= 1)) throw new Error(`WEEK_UNTIL=${process.env.WEEK_UNTIL}: expected a percent, 1 to 100`)
  const rate = planRate()
  const meter = createSessionMeter(rate)
  // the readable live status goes to stderr, next to week-cap's own lines
  const status = createStatus(rate, (l) => process.stderr.write(l))
  fs.mkdirSync(path.dirname(log), { recursive: true })
  const ledgerFile = ledgerOf(log)
  // This session adds what it spends to the week's ledger, so boxes sharing it add up, and a
  // clear or the account's weekly reset from elsewhere simply starts the total again.
  const written = { usd: 0, d7: 0 }
  const record = (resetsAt) => {
    const e = meter.estimate()
    const l = readLedger(ledgerFile)
    if (e.usd === written.usd && !resetsAt) return l
    l.usd = Math.max(0, l.usd + e.usd - written.usd)
    l.d7 = Math.max(0, l.d7 + e.d7 - written.d7)
    l.resetsAt = resetsAt ?? l.resetsAt
    writeLedger(ledgerFile, l)
    written.usd = e.usd
    written.d7 = e.d7
    return l
  }
  const start = readLedger(ledgerFile)
  // the share of the week a sum stands for: an indication, from the plan's calibration
  const about = (d7) => `≈ ${pct(d7)} % of a ${rate.label} week${rate.estimated ? ', estimated' : ''}`
  process.stderr.write(`week-cap: Clank Together ${usd(budget)} a week (${about(budget / rate.d7 / 100)}, plan from ${rate.from}), ${usd(start.usd)} spent ${until(start.resetsAt)}, account ceiling ${pct(CEILING)} %\n`)
  if (budget - start.usd < MIN_RUN) {
    process.stderr.write(`week-cap: nothing left this week; clank clear starts it again from zero\n`)
    return
  }

  const out = fs.createWriteStream(log)
  let reason = null
  let week = null
  let result = null
  let runs = 0
  let ledger = start
  while (!reason) {
    // the dollar backstop covers what is left of the budget
    const backstop = ((budget - ledger.usd) * BACKSTOP).toFixed(2)
    const child = spawn(cmd[0], [...cmd.slice(1), '--max-budget-usd', backstop], { stdio: ['ignore', 'pipe', 'inherit'] })
    runs++
    result = null
    const stop = (why) => {
      if (child.exitCode !== null || reason) return
      reason = why
      child.kill('SIGINT')
      setTimeout(() => child.exitCode === null && child.kill('SIGTERM'), 1e4).unref()
    }
    for await (const line of readline.createInterface({ input: child.stdout })) {
      out.write(line + '\n')
      let msg
      try {
        msg = JSON.parse(line)
      } catch {
        continue
      }
      if (msg.type === 'result') result = msg
      meter.add(msg)
      status(msg)
      const u = weekOf(msg)
      if (u !== null) week = u
      ledger = record(resetOf(msg))
      if (ledger.usd >= budget) stop(`Clank Together spent ${usd(ledger.usd)} this week`)
      else if (week !== null && week >= CEILING) stop(`account week at ${pct(week)} %`)
    }
    await new Promise((r) => (child.exitCode === null ? child.on('close', r) : r()))
    if (reason) break
    ledger = record()
    if (result?.subtype === 'error_max_budget_usd') reason = `dollar backstop ${backstop} $`
    else if (result?.subtype !== 'success') reason = `agent ended: ${result?.subtype ?? 'no result line'}`
    else if (result.num_turns < MIN_TURNS) reason = `agent ended after ${result.num_turns} turns`
    else if (budget - ledger.usd < MIN_RUN) reason = `Clank Together spent ${usd(ledger.usd)} this week`
    else process.stderr.write(`week-cap: agent ended run ${runs} under the cap (${usd(ledger.usd)} this week), starting run ${runs + 1}\n`)
  }
  out.end()
  const e = meter.estimate()
  const tokens = result ? `last run ${(tokensOf(result) / 1e6).toFixed(1)} M tokens, ` : ''
  ledger = readLedger(ledgerFile)
  process.stderr.write(`week-cap: stopped (${reason}) after ${runs} run${runs > 1 ? 's' : ''}: ${tokens}this session ${usd(e.usd)} (${about(e.d7)}); Clank Together ${usd(ledger.usd)} / ${usd(budget)} this week (${about(ledger.d7)}) ${until(ledger.resetsAt)}; account week ${week === null ? '?' : pct(week)} %\n`)
}

if (process.argv[1] === fileURLToPath(import.meta.url)) await main()
CLANK_BOX_FILE_END

COPY --chown=clank:clank <<'CLANK_BOX_FILE_END' /opt/clank-box/lib/week-ledger.mjs
// What Clank Together sessions have spent this week, all sessions together (CLANK_LEDGER, else
// next to their logs). It starts again from zero when the account's weekly window resets (seven_day.resetsAt
// of the rate_limit_event lines) or on `clank clear`.
//   { "usd": <API-price dollars>, "d7": <the share of the week it stands for, an indication>,
//     "resetsAt": <unix seconds of the window's reset, or null> }

import fs from 'node:fs'
import path from 'node:path'

// CLANK_LEDGER: one file for every box on the volume; else next to the logs
export const ledgerOf = (log) => process.env.CLANK_LEDGER || path.join(path.dirname(log), 'week.json')

/** The ledger, or an empty one when there is none yet or when its window has reset. */
export function readLedger(file, now = Date.now()) {
  let l = null
  try {
    l = JSON.parse(fs.readFileSync(file, 'utf8'))
  } catch {
    // none yet
  }
  if (!l || !(l.usd >= 0) || (l.resetsAt && l.resetsAt * 1000 <= now)) return { usd: 0, d7: 0, resetsAt: null }
  return { usd: l.usd, d7: l.d7 || 0, resetsAt: l.resetsAt ?? null }
}

export function writeLedger(file, ledger) {
  fs.writeFileSync(file, JSON.stringify(ledger) + '\n')
}

/** seven_day.resetsAt of one parsed stream-json line, or null. */
export function resetOf(msg) {
  if (msg.type !== 'rate_limit_event') return null
  const r = msg.rate_limit_info?.unifiedWindows?.seven_day?.resetsAt
  return typeof r === 'number' ? r : null
}
CLANK_BOX_FILE_END

COPY --chown=clank:clank --chmod=755 <<'CLANK_BOX_FILE_END' /opt/clank-box/clank
#!/bin/bash
# The box's entry point. Sets up what is missing (agent, its login, the Clank Together
# workspace), then runs the command:
#   run      (default) one capped session, its live status on the terminal
#   login    log the agent in, nothing else
#   status   follow the running session, one line per action
#   top      full-screen view of the running session
#   clear    Clank Together's spend for the week back to zero
#   check    compile units here and compare with the server's exact / mismatch record
#   shell    a shell in the box
set -euo pipefail
LIB=$(dirname "$(readlink -f "$0")")/lib
# BOX=<name>: another box on the same volume (same login, same weekly budget), working in its
# own workspace so that two sessions never share a checkout
export TD_DIR="${TD_DIR:-$HOME/clank/rodecomp${BOX:+-$BOX}}"
# the week's spend, shared by every box on this volume
export CLANK_LEDGER="$HOME/.clank-box-week.json"
cmd="${1:-run}"
[ $# -gt 0 ] && shift

say() { printf '\033[1;36mclank:\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m%s\033[0m\n' "$*" >&2; }
die() {
	printf '\033[1;31mclank: %s\033[0m\n' "$*" >&2
	exit 1
}

case "$cmd" in
status) exec node "$LIB/session-status.mjs" "$@" ;;
top) exec node "$LIB/session-status.mjs" --tui "$@" ;;
clear) exec node "$LIB/week-cap.mjs" clear "$TD_DIR/.td/logs" ;;
check) cd "$TD_DIR" && exec node "$LIB/same-build.mjs" "$@" ;;
shell) exec bash -l ;;
run | login) ;;
*) die "unknown command $cmd (run, login, status, top, clear, check, shell)" ;;
esac

# The cap is arithmetic on fractions: refuse a node that gets them wrong (Node 26 under Rosetta).
[ "$(node -p '0.03 * 100')" = 3 ] || die "this node ($(node -v)) misreads decimal numbers here: the cap cannot work"

# td and cl.exe exist for x86_64 only
[ "$(uname -m)" = x86_64 ] || die "this box was built for $(uname -m): build it with docker build --platform linux/amd64 -t clank-box ."

# --- emulation: Rosetta, or the slow qemu fallback ---
if [ "$(node "$LIB/emulation.mjs")" = qemu ]; then
	warn '
  ============================================================================
  SLOW MODE: x86_64 runs on qemu, not Rosetta. Everything works, compiles are
  several times slower. On a Mac with Apple Silicon:
    1. Docker Desktop > Settings > General
    2. Tick "Use Rosetta for x86_64/amd64 emulation on Apple Silicon"
       (needs "Apple Virtualization framework" as the Virtual Machine Manager)
    3. Apply & restart, then start the box again
  ============================================================================'
fi

# --- the agent: AI, else asked (Enter keeps the last one), installed into the home volume ---
SAVED_AI="$HOME/.clank-box-ai"
last_ai=$(cat "$SAVED_AI" 2>/dev/null || echo claude)
if [ -z "${AI:-}" ] && [ -t 0 ]; then
	read -r -p "AI: claude or codex (codex is untested) [$last_ai]: " AI
fi
AI="${AI:-$last_ai}"
case "$AI" in claude | codex) echo "$AI" >"$SAVED_AI" ;; esac
case "$AI" in
claude)
	if ! command -v claude >/dev/null; then
		say 'installing Claude Code (official installer)'
		curl -fsSL https://claude.ai/install.sh | bash
	fi
	logged_in() {
		[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] || claude auth status --json 2>/dev/null | grep -q '"loggedIn": *true'
	}
	login() { claude auth login; }
	;;
codex)
	# untested: no Codex account has run through the box yet
	if ! command -v codex >/dev/null; then
		say 'installing Codex CLI (official installer)'
		curl -fsSL https://chatgpt.com/codex/install.sh | sh
	fi
	# untested: where Codex keeps its login
	logged_in() { [ -f "$HOME/.codex/auth.json" ]; }
	# untested
	login() { codex login; }
	;;
*) die "AI=$AI: expected claude or codex" ;;
esac

# --- the agent's login, once ---
if ! logged_in; then
	if [ -t 0 ]; then
		say "first start: log $AI in"
		login
	else
		die "$AI is not logged in and this terminal takes no input: start the box with docker run -it"
	fi
fi
[ "$cmd" = login ] && exit 0

# --- the Clank Together workspace: the official installer, after the agent so its
#     td connect registers the MCP server with it ---
if [ ! -f "$TD_DIR/.td/config.json" ]; then
	# a second box reuses the first one's token; without one, install.sh asks for it
	FIRST="$HOME/clank/rodecomp/.td/config.json"
	[ -n "${TD_TOKEN:-}" ] || [ ! -f "$FIRST" ] || TD_TOKEN=$(node -p 'require(process.argv[1]).token' "$FIRST")
	export TD_TOKEN
	[ -n "${TD_TOKEN:-}" ] || [ -t 0 ] || die 'no workspace yet: start the box with TD_TOKEN=<your token> (log in on https://clank.rodecomp.online, Account)'
	say "installing the Clank Together workspace into $TD_DIR (official install.sh)"
	[ -n "${TD_TOKEN:-}" ] || say 'your Clank Together token: log in on https://clank.rodecomp.online, Account, create one'
	curl -fsSL https://clank.rodecomp.online/install.sh | sh
fi

# TD_JOBS: how many cl.exe at once (td's own default is cores - 2). Written into the
# workspace's runners, since `td toolchain install` resets it.
node -e 'const fs = require("node:fs"), [f, n] = process.argv.slice(1)
const c = JSON.parse(fs.readFileSync(f, "utf8"))
let changed = false
for (const k in c.runners ?? {}) if (c.runners[k].jobs !== +n) { c.runners[k].jobs = +n; changed = true }
if (changed) fs.writeFileSync(f, JSON.stringify(c, null, 2) + "\n")' "$TD_DIR/.td/config.json" "$TD_JOBS"

if [ "$AI" = codex ]; then
	say 'Codex is installed, logged in and connected to td. Capped Codex sessions are not there yet:'
	say "for now run it yourself: docker run -it --rm -e AI=codex -v clank-home:/home/clank clank-box shell, then cd \"$TD_DIR\" && codex"
	exit 0
fi

# --- the weekly budget in API-price dollars: WEEK_USD, else asked (Enter keeps the last one) ---
SAVED="$HOME/.clank-box-week-usd"
last=$(cat "$SAVED" 2>/dev/null || echo 50)
if [ -z "${WEEK_USD:-}" ] && [ -t 0 ]; then
	# what one dollar stands for on the detected plan, as an indication
	node -e 'import(process.argv[1]).then(({ planRate }) => { const r = planRate(); console.error(`On ${r.label} (from ${r.from}), ${r.d7.toFixed(1)} $ ≈ 1 % of the week${r.estimated ? " (estimated)" : ""}.`) })' "$LIB/quota.mjs"
	read -r -p "Weekly budget for Clank Together, in \$ [$last]: " WEEK_USD
fi
WEEK_USD="${WEEK_USD:-$last}"
case "$WEEK_USD" in '' | *[!0-9.]* | *.*.*) die "budget: a number of dollars, like 50 (got $WEEK_USD)" ;; esac
echo "$WEEK_USD" >"$SAVED"

# --- one session, stopped once Clank Together has spent WEEK_USD this week (all sessions of the
#     week together) or once the account's week reaches WEEK_UNTIL % ---
cd "$TD_DIR"
LOG="$TD_DIR/.td/logs/run-$(date +%Y%m%d-%H%M%S).jsonl"
say "session log $LOG"
exec node "$LIB/week-cap.mjs" "$WEEK_USD" "$LOG" -- \
	claude -p "Read AGENTS.md and CODING_RULES.md and follow them strictly, then work on Clank Together continuously. Once you've finished a batch, start a new one without interruption." \
	--model claude-opus-5-5 \
	--permission-mode auto \
	--setting-sources project,local \
	--strict-mcp-config \
	--mcp-config "{\"mcpServers\":{\"clank-together\":{\"command\":\"$HOME/.local/bin/td\",\"args\":[\"mcp\",\"--workspace\",\"$TD_DIR\"]}}}" \
	--output-format stream-json --verbose
CLANK_BOX_FILE_END

ENV PATH=/home/clank/.local/bin:/opt/clank-box:$PATH \
	WEEK_UNTIL=80 TD_JOBS=4
WORKDIR /home/clank
# tini as PID 1: Ctrl+C and docker stop reach the session
ENTRYPOINT ["tini", "--", "clank"]
CMD ["run"]
