# Copy to .env (ignored), fill the three blank secret/application values, and choose a real HTTPS hostname.
# roles.rodecomp.online is a proposed hostname, not a provisioned deployment.
PUBLIC_URL=https://roles.rodecomp.online
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
CLANK_API_URL=https://rodecomp.online
SYNC_INTERVAL_SECONDS=60
# Local Node deployment paths; Compose uses /source/td.sqlite and /state/roles.sqlite instead.
SOURCE_DB_PATH=/source/td.sqlite
STATE_DB_PATH=./data/roles.sqlite
HOST=127.0.0.1
PORT=19581
# DISCORD_REDIRECT_URI is derived as PUBLIC_URL + /api/discord/callback.
# Optional explicit value must exactly match; do not configure a different callback.
# Keep DISCORD_BOT_TOKEN only in a separate .env.setup file for the one-time setup CLI.
